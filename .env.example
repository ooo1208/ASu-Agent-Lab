# ASu Agent Lab. Copy to .env for live mode; demo needs no model credentials.
ASU_DATA_DIR=.local/asu
ASU_RELEASE=local
ASU_PROMPT_RELEASE=v1
DEEPSEEK_API_KEY=replace-with-your-model-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
MAIN_MODEL=deepseek-chat
SUMMARY_MODEL=deepseek-chat
MODEL_TEMPERATURE=0.2
MODEL_MAX_OUTPUT_TOKENS=8192
SUMMARY_MAX_OUTPUT_TOKENS=2048
# Optional search provider.
ZHIPU_API_KEY=
# Live authentication. Generate at least 32 random characters.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRE_HOURS=12
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=asu_agent
ERP_API_BASE_URL=http://127.0.0.1:8080/api
ERP_API_KEY=
ERP_MCP_URL=http://127.0.0.1:8000/mcp
MCP_HOST=127.0.0.1
MCP_PORT=8000
ASYNC_AGENT_PROTOCOL_URL=http://127.0.0.1:2024
API_PROXY_TARGET=http://127.0.0.1:8090
# Live sandbox; quote URL must be reachable from inside its container.
OPENSANDBOX_URL=http://127.0.0.1:8100
OPENSANDBOX_API_KEY=
SANDBOX_IMAGE=asu-agent-sandbox:v1
SANDBOX_RUNTIME_INSTALL_FALLBACK=false
APP_ENV=development
QUOTE_BASE_URL=http://127.0.0.1:8086
# Optional chart MCP, disabled unless configured.
CHART_MCP_URL=
# Opt-in remote delivery: start_all.py --delivery langfuse.
# Offline mode scores locally and retains pending Outbox items.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
ASU_MAX_LATENCY_MS=900000
RUN_LIVE_LLM_TESTS=0
RUN_ERP_WRITE_TESTS=0
