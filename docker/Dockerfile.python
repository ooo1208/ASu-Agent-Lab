FROM ghcr.io/astral-sh/uv:0.11.2 AS uv
FROM python:3.11-slim-bookworm

COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PYTHONUNBUFFERED=1 ASU_DATA_DIR=/app/data

# Copy only project inputs; .env, local databases and host virtualenvs are excluded.
COPY pyproject.toml uv.lock README.md LICENSE SOURCES.md ./
COPY src ./src
COPY evals ./evals
RUN uv sync --locked --no-dev \
    && useradd --system --uid 10001 --create-home asu \
    && mkdir -p /app/data \
    && chown -R asu:asu /app

ENV PATH="/app/.venv/bin:$PATH"
USER asu
EXPOSE 8090
CMD ["python", "-m", "uvicorn", "asu_lab.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8090"]
